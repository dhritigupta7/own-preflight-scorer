# Copy this file to `secrets.toml` (same folder) and fill in your keys.
# `secrets.toml` is git-ignored so real keys never get committed.
# These are the SAME keys the daily pipeline uses.

GEMINI_API_KEY = "your-gemini-key-here"
GROQ_API_KEY   = "your-groq-key-here"

# Durable score history (secret GitHub Gist).
# Token needs ONLY the `gist` scope — github.com/settings/tokens
GH_GIST_TOKEN = "your-github-pat-with-gist-scope"
GH_GIST_ID    = "your-gist-id"
